# ============ DualRAG Backend Environment Configuration ============




EMBEDDING_DIMENSIONS = 768

# ── Gemini Final LLM ──
GOOGLE_API_KEY= YOUR_API_KEY 
LLM_MODEL=gemini-3.5-pro
EMBEDDING_MODEL=textembedding-gecko-001
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ── NVIDIA BUILD API (reranker) ──
NVIDIA_API_KEY=YOUR_API_KEY 

# ── Server ──
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Qdrant Vector Database ──
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=dualrag_documents

# ── Chunking ──
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ── Retrieval ──
RETRIEVAL_TOP_K=15
RERANK_TOP_N=5

# ── Storage ──
DOCUMENT_STORE_PATH=storage/documents.json
